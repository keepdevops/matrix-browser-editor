{
  "name": "matrix-browser-editor",
  "version": "1.0.0",
  "description": "Standalone browser automation + UI interaction tool for React apps",
  "main": "index.js",
  "scripts": {
    "start": "bash scripts/start.sh",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "test": "node run.js --url http://localhost:5173",
    "test:layout": "node run.js layouts --url http://localhost:5173",
    "test:components": "node run.js components --url http://localhost:5173",
    "test:swarm-matrix": "node run.js swarm-matrix --url http://localhost:5173",
    "test:share": "node run.js share --url http://localhost:5173",
    "test:llamacpp": "node run.js llamacpp --url http://localhost:5173",
    "headed": "node run.js --headed --url http://localhost:5173",
    "install:browsers": "npx playwright install chromium",
    "shutdown": "bash scripts/shutdown.sh"
  },
  "keywords": [
    "browser",
    "playwright",
    "react",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0"
  }
}
